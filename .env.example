# LOCAL DEVELOPMENT
# VITE_API_URL=http://localhost:5173/
# VITE_API_BASE_URL=http://localhost:8000/
# VITE_WS_URL=ws://localhost:8000

# PRODUCTION (Railway)
VITE_API_URL=https://your-railway-app.up.railway.app
VITE_API_BASE_URL=https://e365backend-production.up.railway.app
VITE_WS_URL=wss://e365backend-production.up.railway.app
VITE_APP_NAME=E365 Events
